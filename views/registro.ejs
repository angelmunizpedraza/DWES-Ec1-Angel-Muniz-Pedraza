<!DOCTYPE html>
<html lang="es">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>
        <%= titulo %> - Sueños Valenti
    </title>
    <link rel="stylesheet" href="/css/estilos.css">
</head>

<body class="<%= tema %>">
    <header>
        <h1>✨ Sueños Valenti ✨</h1>
        <nav>
            <a href="/">Inicio</a>
            <a href="/sesiones">Sesiones</a>
            <a href="/preferencias">Preferencias</a>
            <% if (usuario) { %>
                <a href="/perfil">Mi Perfil</a>
                <a href="/carrito">Carrito</a>
                <% } else { %>
                    <a href="/login">Entrar</a>
                    <a href="/registro">Registrarse</a>
                    <% } %>
        </nav>
    </header>

    <main>
        <div class="contenedor">
            <h2>Crear cuenta</h2>
            <p class="mb-2">Únete a nuestra comunidad espiritual</p>

            <% if (errores && errores.length> 0) { %>
                <div class="errores">
                    <strong>Por favor corrige los siguientes errores:</strong>
                    <ul>
                        <% errores.forEach(function(error) { %>
                            <li>
                                <%= error %>
                            </li>
                            <% }); %>
                    </ul>
                </div>
                <% } %>

                    <form action="/registro" method="POST">
                        <div class="form-grupo">
                            <label for="nombre">Nombre completo *</label>
                            <input type="text" id="nombre" name="nombre" value="<%= datos.nombre || '' %>"
                                placeholder="Tu nombre">
                        </div>

                        <div class="form-grupo">
                            <label for="email">Correo electrónico *</label>
                            <input type="email" id="email" name="email" value="<%= datos.email || '' %>"
                                placeholder="tu@email.com">
                        </div>

                        <div class="form-grupo">
                            <label for="edad">Edad *</label>
                            <input type="number" id="edad" name="edad" value="<%= datos.edad || '' %>" min="1"
                                placeholder="Tu edad">
                        </div>

                        <div class="form-grupo">
                            <label for="ciudad">Ciudad</label>
                            <input type="text" id="ciudad" name="ciudad" value="<%= datos.ciudad || '' %>"
                                placeholder="¿Dónde vives?">
                        </div>

                        <div class="form-grupo">
                            <label>Intereses espirituales</label>
                            <div class="checkbox-grupo">
                                <label>
                                    <input type="checkbox" name="intereses" value="meditacion" <%=(datos.intereses &&
                                        datos.intereses.includes('meditacion')) ? 'checked' : '' %>>
                                    Meditación
                                </label>
                                <label>
                                    <input type="checkbox" name="intereses" value="yoga" <%=(datos.intereses &&
                                        datos.intereses.includes('yoga')) ? 'checked' : '' %>>
                                    Yoga
                                </label>
                                <label>
                                    <input type="checkbox" name="intereses" value="cristales" <%=(datos.intereses &&
                                        datos.intereses.includes('cristales')) ? 'checked' : '' %>>
                                    Cristales
                                </label>
                                <label>
                                    <input type="checkbox" name="intereses" value="astrologia" <%=(datos.intereses &&
                                        datos.intereses.includes('astrologia')) ? 'checked' : '' %>>
                                    Astrología
                                </label>
                                <label>
                                    <input type="checkbox" name="intereses" value="tarot" <%=(datos.intereses &&
                                        datos.intereses.includes('tarot')) ? 'checked' : '' %>>
                                    Tarot
                                </label>
                                <label>
                                    <input type="checkbox" name="intereses" value="viajes-astrales" <%=(datos.intereses
                                        && datos.intereses.includes('viajes-astrales')) ? 'checked' : '' %>>
                                    Viajes Astrales
                                </label>
                            </div>
                        </div>

                        <div class="mt-2">
                            <button type="submit" class="btn btn-primario">Crear mi cuenta</button>
                        </div>
                    </form>

                    <p class="mt-2">
                        ¿Ya tienes cuenta? <a href="/login">Inicia sesión aquí</a>
                    </p>
        </div>
    </main>

    <footer>
        <p>&copy; 2024 Sueños Valenti - Conecta con tu supra conciencia</p>
    </footer>
</body>

</html>