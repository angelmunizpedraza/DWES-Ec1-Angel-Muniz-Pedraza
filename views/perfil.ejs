<!DOCTYPE html>
<html lang="es">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>
        <%= titulo %> - Sueños Valenti
    </title>
    <link rel="stylesheet" href="/css/estilos.css">
</head>

<body class="<%= tema %>">
    <header>
        <h1>✨ Sueños Valenti ✨</h1>
        <nav>
            <a href="/">Inicio</a>
            <a href="/sesiones">Sesiones</a>
            <a href="/preferencias">Preferencias</a>
            <% if (usuario) { %>
                <a href="/perfil">Mi Perfil</a>
                <a href="/carrito">Carrito</a>
                <% } else { %>
                    <a href="/login">Entrar</a>
                    <a href="/registro">Registrarse</a>
                    <% } %>
        </nav>
    </header>

    <main>
        <div class="contenedor">
            <div class="flex-between mb-2">
                <h2>Mi Perfil</h2>
                <form action="/logout" method="POST" style="margin: 0;">
                    <button type="submit" class="btn btn-peligro">Cerrar Sesión</button>
                </form>
            </div>

            <div class="perfil-info">
                <p><strong>Nombre:</strong>
                    <%= usuario.nombre %>
                </p>
                <p><strong>Email:</strong>
                    <%= usuario.email %>
                </p>
                <p><strong>Edad:</strong>
                    <%= usuario.edad %> años
                </p>
                <% if (usuario.ciudad) { %>
                    <p><strong>Ciudad:</strong>
                        <%= usuario.ciudad %>
                    </p>
                    <% } %>
                        <% if (usuario.intereses && usuario.intereses.length> 0) { %>
                            <p><strong>Intereses:</strong>
                                <%= usuario.intereses.join(', ') %></p>
                <% } %>
            </div>
            
            <div class="mt-3">
                <h3>Acciones rápidas</h3>
                <div class="flex mt-2">
                    <a href="/sesiones" class="btn btn-primario">Ver Sesiones</a>
                    <a href="/carrito" class="btn btn-secundario">Mi Carrito</a>
                </div>
            </div>
        </div>
    </main>
    
    <footer>
        <p>&copy; 2024 Sueños Valenti - Conecta con tu supra conciencia</p>
    </footer>
</body>
</html>